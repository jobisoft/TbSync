[
  {
    "namespace": "calendar.calendars",
    "types": [
      {
        "id": "Calendar",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "cacheId": { "type": "string", "optional": true },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "visible": { "type": "boolean" },
          "showReminders": { "type": "boolean" },
          "color": { "type": "string", "optional": true },
          "refreshInterval": { "type": "integer", "minimum": 0, "optional": true, "description": "Minutes between automatic refreshes by Thunderbird, 0 meaning never. A calendar that was never given a value reports the default of 30." },
          "capabilities": { "$ref": "CalendarCapabilities", "optional": true }
        }
      },
      {
        "id": "CalendarChangeProps",
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "visible": { "type": "boolean" },
          "showReminders": { "type": "boolean" },
          "color": { "type": "string", "optional": true },
          "refreshInterval": { "type": "integer", "minimum": 0, "optional": true, "description": "Minutes between automatic refreshes by Thunderbird, 0 meaning never. A calendar that was never given a value reports the default of 30." }
        }
      },
      {
        "id": "CalendarCapabilitiesOverride",
        "type": "object",
        "description": "Capabilities of a calendar to override the defaults defined in the manifest of the provider.",
        "properties": {
          "timezones": {
            "type": "object",
            "optional": "omit-key-if-missing",
            "properties": {
              "floating": { "type": "boolean", "optional": "omit-key-if-missing" },
              "UTC": { "type": "boolean", "optional": "omit-key-if-missing" }
            }
          },
          "organizer": { "type": "string", "optional": "omit-key-if-missing" },
          "organizerName": { "type": "string", "optional": "omit-key-if-missing" },
          "attachments": { "type": "boolean", "optional": "omit-key-if-missing" },
          "priority": { "type": "boolean", "optional": "omit-key-if-missing" },
          "privacy": {
            "optional": "omit-key-if-missing",
            "choices": [
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "categories": {
            "type": "object",
            "optional": "omit-key-if-missing",
            "properties": {
              "count": { "type": "integer", "minimum": -1, "optional": "omit-key-if-missing" }
            }
          },
          "alarms": {
            "type": "object",
            "optional": "omit-key-if-missing",
            "properties": {
              "count": { "type": "integer", "minimum": -1, "optional": "omit-key-if-missing" },
              "actions": { "type": "array", "items": { "type": "string" }, "optional": "omit-key-if-missing" }
            }
          },
          "tasks": {
            "type": "boolean",
            "optional": "omit-key-if-missing",
            "description": "Whether the calendar supports tasks. Overrides the value of the manifest."
          },
          "events": {
            "type": "boolean",
            "optional": "omit-key-if-missing",
            "description": "Whether the calendar supports events. Overrides the value of the manifest."
          },
          "removeModes": {
            "type": "array",
            "optional": "omit-key-if-missing",
            "items": {
              "type": "string",
              "enum": ["unsubscribe", "delete"]
            },
            "description": "How the calendar can be removed. Overrides the value of the manifest."
          },
          "requiresNetwork": { "type": "boolean", "optional": "omit-key-if-missing" },
          "minimumRefreshInterval": { "type": "integer", "minimum": -1, "optional": "omit-key-if-missing" },
          "mutable": {
            "type": "boolean",
            "optional": "omit-key-if-missing",
            "description": "Whether items of the calendar can be changed. Overrides the value of the manifest."
          },
          "scheduling": {
            "type": "string",
            "optional": "omit-key-if-missing",
            "enum": ["client", "server", "none"],
            "description": "Who sends invitations. Overrides the value of the manifest."
          }
        }
      },
      {
        "id": "CalendarCapabilities",
        "type": "object",
        "description": "The capabilities of a calendar.",
        "properties": {
          "timezones": {
            "type": "object",
            "optional": true,
            "properties": {
              "floating": { "type": "boolean", "optional": true },
              "UTC": { "type": "boolean", "optional": true }
            }
          },
          "organizer": { "type": "string", "optional": true },
          "organizerName": { "type": "string", "optional": true },
          "attachments": { "type": "boolean", "optional": true },
          "priority": { "type": "boolean", "optional": true },
          "privacy": {
            "optional": true,
            "choices": [
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "categories": {
            "type": "object",
            "optional": true,
            "properties": {
              "count": { "type": "integer", "minimum": -1, "optional": true }
            }
          },
          "alarms": {
            "type": "object",
            "optional": true,
            "properties": {
              "count": { "type": "integer", "minimum": -1, "optional": true },
              "actions": { "type": "array", "items": { "type": "string" }, "optional": true }
            }
          },
          "tasks": {
            "type": "boolean",
            "optional": true,
            "default": true,
            "description": "Whether the calendar supports tasks."
          },
          "events": {
            "type": "boolean",
            "optional": true,
            "default": true,
            "description": "Whether the calendar supports events."
          },
          "removeModes": {
            "type": "array",
            "optional": true,
            "default": ["unsubscribe"],
            "items": {
              "type": "string",
              "enum": ["unsubscribe", "delete"]
            },
            "description": "How the calendar can be removed."
          },
          "requiresNetwork": { "type": "boolean", "optional": true },
          "minimumRefreshInterval": { "type": "integer", "minimum": -1, "optional": true },
          "mutable": {
            "type": "boolean",
            "optional": true,
            "default": true,
            "description": "Whether items of the calendar can be changed."
          },
          "scheduling": {
            "type": "string",
            "optional": true,
            "default": "client",
            "enum": ["client", "server", "none"],
            "description": "Who sends invitations."
          }
        }
      }
    ],
    "functions": [
      {
        "name": "query",
        "async": "callback",
        "type": "function",
        "parameters": [
          {
            "type": "object",
            "name": "queryInfo",
            "properties": {
              "type": { "type": "string", "optional": true },
              "url": { 
                "choices": [
                  {"type": "string"},
                  {"type": "array", "items": {"type": "string"}}
                ],
                "optional": true
              },
              "name": { "type": "string", "optional": true },
              "color": { "type": "string", "optional": true },
              "readOnly": { "type": "boolean", "optional": true },
              "visible": { "type": "boolean", "optional": true },
              "enabled": { "type": "boolean", "optional": true }
            }
          },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "type": "array",
                "items": { "$ref": "Calendar" },
                "description": "The calendars that match."
              }
            ]
          }
        ]
      },
      {
        "name": "get",
        "async": "callback",
        "type": "function",
        "parameters": [
          { "type": "string", "name": "id" },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "choices": [
                  { "$ref": "Calendar" },
                  { "type": "null" }
                ],
                "description": "The calendar, or null if there is no calendar with that id."
              }
            ]
          }
         ]
       },
      {
        "name": "create",
        "async": "callback",
        "type": "function",
        "parameters": [
          {
            "type": "object",
            "name": "createProperties",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "url": { "type": "string" },
              "readOnly": { "type": "boolean", "optional": true },
              "enabled": { "type": "boolean", "optional": true },
              "visible": { "type": "boolean", "optional": true },
              "showReminders": { "type": "boolean", "optional": true },
              "color": { "type": "string", "optional": true },
              "refreshInterval": { "type": "integer", "minimum": 0, "optional": true, "description": "Minutes between automatic refreshes by Thunderbird, 0 disabling them. Thunderbird's default of 30 applies if the calendar has none. Not allowed for a calendar that cannot refresh." },
              "capabilities": {
                "$ref": "CalendarCapabilitiesOverride",
                "optional": true
              }
            }
          },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "$ref": "Calendar",
                "description": "The created calendar."
              }
            ]
          }
        ]
      },
      {
        "name": "update",
        "async": true,
        "type": "function",
        "parameters": [
          { "type": "string", "name": "id" },
          {
            "type": "object",
            "name": "updateProperties",
            "properties": {
              "name": { "type": "string", "optional": true },
              "url": { "type": "string", "optional": true },
              "readOnly": { "type": "boolean", "optional": true },
              "enabled": { "type": "boolean", "optional": true },
              "color": { "type": "string", "optional": true },
              "refreshInterval": { "type": "integer", "minimum": 0, "optional": true, "description": "Minutes between automatic refreshes by Thunderbird, 0 disabling them. Thunderbird's default of 30 applies if the calendar has none. Not allowed for a calendar that cannot refresh." },
              "lastError": { "type": "string", "optional": true },
              "capabilities": {
                "$ref": "CalendarCapabilitiesOverride",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "remove",
        "async": true,
        "type": "function",
        "parameters": [
          { "type": "string", "name": "id" }
        ]
      },
      {
        "name": "clear",
        "async": true,
        "type": "function",
        "parameters": [
          { "type": "string", "name": "id" }
        ]
      },
      {
        "name": "synchronize",
        "async": true,
        "type": "function",
        "parameters": [
          {
            "optional": true,
            "name": "ids",
            "choices": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onCreated",
        "type": "function",
        "parameters": [
          { "name": "calendar", "$ref": "Calendar" }
        ]
      },
      {
        "name": "onUpdated",
        "type": "function",
        "parameters": [
          { "name": "calendar", "$ref": "Calendar" },
          { "name": "changeInfo", "$ref": "CalendarChangeProps" }
        ]
      },
      {
        "name": "onRemoved",
        "type": "function",
        "parameters": [
          { "name": "id", "type": "string" }
        ]
      }
    ]
  }
]
